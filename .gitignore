# --- Local-only notes (private: personal URLs, secrets, scratch). NEVER commit ---
# Convention: any *.local.md is a per-machine note (e.g. the personal artifact URL).
*.local.md
# Claude Code auto-loads CLAUDE.local.md next to CLAUDE.md: your own operating notes
# (setup-specific workflow). Already covered by *.local.md; listed explicitly so it is never lost.
CLAUDE.local.md

# Your working notes (feature task docs, progress, queued work) — kept locally, never published.
odd/

# Backups of personal data files taken before a hand edit (*.bak), and the
# folder that keeps the latest one per file. Personal data: never commit.
*.bak
/backups/

# --- Sensitive health data: NEVER commit ---
# Raw Apple Health export and any parsed personal metrics stay local only.
data/apple-health/*
!data/apple-health/.gitkeep
# extract.mjs is plain tooling (no data) → trackable; its extract/ output stays ignored.
!data/apple-health/extract.mjs
# The Shortcut/Strava syncs and their tests are tooling (synthetic fixtures only, no personal
# values).
!data/apple-health/sync-common.mjs
!data/apple-health/sync-shortcut.mjs
!data/apple-health/sync-strava.mjs
!data/apple-health/*.test.mjs
# The Apple Health export ships as an `export*.zip` / `exportación.zip` archive and
# unzips to an `apple_health_export/` folder (a ~400MB+ export_cda.xml + workout-routes
# GPX). These often land OUTSIDE data/apple-health/ (e.g. straight in data/), so ignore
# them wherever they appear — a raw export drop must never be committable.
**/apple_health_export/
**/export*.zip
**/exportación.zip
# data/demo/ is intentionally TRACKED: clearly synthetic CSVs from scripts/make-demo-data.mjs
# that the example build reads (see data/demo/README.md). Never put real measurements there.
!data/demo/

# Personal logs contain medical/behavioral data. Keep templates, ignore real data.
data/weight/weight-log.md
data/nutrition/food-log.md
data/nutrition/plan-web.html
# The LAN copy of plan-web.html served by services/loop-web — same personal content.
services/loop-web/site/
# refresh.sh's flock lock file (runtime-only, never content).
services/loop-web/.refresh.lock
# refresh.sh last-good-publish state (JSON fragment reused by error writes; runtime-only).
services/loop-web/.refresh-state
services/loop-web/.refresh-state.tmp
# loop-web local config (PLAN_WEB_EXTRA_HOSTS, INGEST_PORT…); a template stays trackable.
services/loop-web/.env
services/loop-web/.env.*
!services/loop-web/.env.example
# loop-ingest on-demand refresh trigger (runtime file written by POST /sync).
services/loop-ingest/trigger/
# Pre-LOOP folder names (services/plan-web, services/health-ingest): a clone pulled before its migration
# still keeps its runtime files there (the page, .env, the trigger) until they are moved; never track them.
services/plan-web/
services/health-ingest/
# plan-data.json holds the PERSONAL plan (recipes, day structure, targets); plan-tables.md
# is generated from it. Both hold personal plan data → ignore.
data/nutrition/plan-data.json
data/nutrition/plan-tables.md
# Food log export written by data/nutrition/sync-foodlog.mjs (per-day sums of your LAN food
# log) — personal. The script and its test are plain tooling → tracked by default.
data/nutrition/foodlog-daily.csv
data/nutrition/foodlog-daily.meta.json
# NOTE: ingredients.json (the public, reusable food DB — per-100g macros + product labels)
# and generate.mjs (plain tooling) carry NO personal plan data and are intentionally TRACKED.
# generate.mjs MERGES the tracked ingredients.json with the personal plan-data.json.
# The .template/.example seeds carry NO personal data and are intentionally TRACKED
# (they are the public starting point a fresh clone copies to the names ignored above).
# Patterns above match the exact personal filenames only, so ingredients.json and the
# seeds stay trackable.

# Generated reports may quote personal metrics.
analysis/reports/*
!analysis/reports/.gitkeep

# Profile holds personal identifiers. Decide consciously before un-ignoring.
profile/about-me.md
profile/baseline.md
# Manual profile card data (birthdate, height, devices). The .example seed is tracked.
profile/profile.json
# Coach config: the user's knowledge sources, gear, program and locale (read first by the coach
# subagents). The .example template is tracked.
profile/coaches.md

# Strava profile snapshot + avatar pulled by data/profile/sync-profile.mjs (name, city, gear,
# photo) and the goal / target-weight snapshot (settings.json, data/profile/sync-settings.mjs)
# — personal. The sync scripts, their tests and .gitkeep are plain tooling → tracked.
data/profile/*
!data/profile/.gitkeep
!data/profile/sync-profile.mjs
!data/profile/sync-profile.test.mjs
!data/profile/sync-settings.mjs
!data/profile/sync-settings.test.mjs

# OS / tooling noise
.DS_Store
*.log
.atl/
.codegraph/

# Personal training programs (PDFs, podcasts, the real program JSON stay local).
# The tooling now lives in lib/training/ + lib/health/ (tracked by default,
# no exception needed) and scripts/build-web.mjs. The public example seed IS tracked.
data/training/*
!data/training/.gitkeep
!data/training/training-data.example.json

# Nutritionist reports (anthropometric assessments + nutrition plans) — medical data
data/nutritionist/*
!data/nutritionist/.gitkeep

# Gear manuals / device docs dropped locally (public docs, but keep the repo clean).
data/gear/*
!data/gear/.gitkeep

# Clinical documents (ER reports, discharge notes, lab results) — medical data, NEVER commit.
data/clinical/*
!data/clinical/.gitkeep

# Golden legacy-output fixtures (astro-plan-web migration): a local snapshot of
# generator output used to check byte-identity during the lib/ extraction. Quotes
# personal plan/training/health data → never commit.
web/test/.golden/

# Astro build (web/): installed deps, build output, and Astro/Vite caches.
# (A bare "node_modules/" pattern matches at any depth, so this also covers
# the nested web/node_modules/ that Astro/Vite create for their own caches
# since web/ is the Astro project root.)
node_modules/
web/dist/
web/.astro/
web/.test-dist/

# Knowledge base (knowledge/): transcripts and summaries of third-party content
# (e.g. YouTube videos) for personal use only — never committed. Only the README
# describing the layout is tracked.
knowledge/*
!knowledge/README.md

# Personal tools, never published (e.g. a private training-program sync against a
# login-gated service). Run them in place: `node local/<tool>/<script>.mjs`.
/local/

# Claude Code local files (per machine, never published)
.claude/settings.local.json
.claude/worktrees/
/.astro/
skill-registry.md
.skill-registry.cache.json
