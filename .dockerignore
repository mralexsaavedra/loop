# Build context of the loop-server image (docker/loop-server.Dockerfile, context = the repo root). DEFAULT DENY:
# only the code and the tracked seeds the image needs are sent to the Docker daemon; everything else stays out,
# above all every personal file (loop-data/, profile/*.md, data/** personal files, backups/, knowledge/, local/,
# analysis/reports/, .env*, the built pages). scripts/dockerignore.test.mjs pins it.
*

# the page toolchain
!package.json
!package-lock.json
!lib/**
!web/astro.config.mjs
!web/layouts/**
!web/pages/**
!web/src/**
!scripts/*.mjs
!scripts/lib/*.mjs
!data/apple-health/*.mjs
!data/nutrition/*.mjs
!data/nutrition/ingredients.json
!data/nutrition/plan-data.example.json
!data/profile/*.mjs
!data/training/training-data.example.json

# the data service
!services/loop-ingest/package.json
!services/loop-ingest/package-lock.json
!services/loop-ingest/src/**
!services/loop-ingest/sql/**

# never, even inside a folder let in above: tests, dependencies, secrets, build caches
**/*.test.mjs
**/*.test.js
**/node_modules
**/.env*
**/.astro
