# LOOP server (docker/docker-compose.yml). Copy to .env next to the compose file and fill it in; .env holds secrets
# and is never committed (docker/.gitignore).

# The image tag: mralexandersaavedra/loop-server:<HC_VERSION> and mralexandersaavedra/loop-web:<HC_VERSION>
HC_VERSION=1.0.0
# Empty for the first install; a short name (e.g. second) for another install on the same host
HC_INSTANCE=

# Bearer token for the iOS Shortcut and the coach's npm run sync (at least 32 characters): openssl rand -hex 32
INGEST_TOKEN=

# The database (any character works in the password)
POSTGRES_USER=loop
POSTGRES_PASSWORD=
POSTGRES_DB=loop

# The host port of the data API (the iOS Shortcut can also post through the page's port; a coach clone's npm run sync
# uses this one), and the address it is published on: 127.0.0.1 = loopback only, recommended (a coach clone on this
# machine); a coach clone on another computer needs the server's LAN IP here (never a public address)
INGEST_PORT=8088
INGEST_BIND=127.0.0.1

# The owner files folder on the host: import/ (Health exports), manuals/ (device manuals), documents/ (coach PDFs)
HC_FILES_LOCATION=./files

# Minutes between the automatic page builds (5-1440)
HC_REFRESH_MINUTES=60

# Seconds the Apple Health import (the newest .zip in files/import/) may take before it is stopped (1-86400)
HC_IMPORT_TIMEOUT=1800
# Largest Health export taken out of a zip, in bytes (10 GiB; a 10-year Apple Watch export is a few GB).
HC_IMPORT_MAX_BYTES=10737418240

# Optional: Strava (services/loop-ingest/README.md -> Strava)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_SYNC_MINUTES=30

# The page (loop-web): its host port, and the address it is published on (the LAN IP; an IPv6 address in brackets;
# empty = every address). Docker-published ports bypass ufw / firewalld, so set it on a host with a public address.
PLAN_WEB_PORT=8090
PLAN_WEB_BIND=

# Optional: extra host names the page may be reached by, besides IP literals and localhost (comma or space
# separated). Set the same names in both: PLAN_WEB_EXTRA_HOSTS (loop-web) and FOOD_ALLOWED_HOSTS (loop-server).
PLAN_WEB_EXTRA_HOSTS=
FOOD_ALLOWED_HOSTS=
