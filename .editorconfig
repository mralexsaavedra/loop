# The repo's current style (ESLint checks correctness only, not formatting: eslint.config.mjs).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# a trailing double space is a Markdown line break
trim_trailing_whitespace = false
