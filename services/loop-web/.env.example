# loop-web settings: copy to .env (`cp -n .env.example .env`) and uncomment what you change.
# Every variable is optional; unset, docker-compose.yml uses the default shown.

# Host port of the page.
# PLAN_WEB_PORT=8090

# Publish the page on this host address only (the LAN IP; an IPv6 address in brackets). Docker ignores ufw /
# firewalld for published ports, so set it on a host with a public address. Empty = every address.
# PLAN_WEB_BIND=192.168.1.10

# Extra host names the page may be reached by, besides IP literals and localhost (comma or space separated).
# Mirror them in services/loop-ingest/.env as FOOD_ALLOWED_HOSTS.
# PLAN_WEB_EXTRA_HOSTS=plan.lan

# A second install on the same host (README -> Running a second install); empty = the plain names.
# HC_INSTANCE=second
