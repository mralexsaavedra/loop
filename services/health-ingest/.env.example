# Generate with: openssl rand -hex 32
INGEST_TOKEN=replace-me-with-64-hex-chars

POSTGRES_PASSWORD=replace-me
POSTGRES_USER=health
POSTGRES_DB=health

# Port exposed on the host 'apps'; Pangolin's target points here.
INGEST_PORT=8088

# Strava API v3 — create an application at https://www.strava.com/settings/api
# Leave blank to run Apple Health ingestion only.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_SYNC_MINUTES=30
