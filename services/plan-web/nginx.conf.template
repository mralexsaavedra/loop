# nginx:alpine renders this template into /etc/nginx/conf.d/default.conf at
# start, substituting ONLY variables defined in the container environment
# (${INGEST_PORT}, see docker-compose.yml); nginx's own $variables are left
# untouched.
#
# The Astro build already declares <meta charset="utf-8">, but nginx sending
# the header too is cheap insurance against browsers guessing Latin-1 and
# garbling accents/emoji before the <head> is parsed.

# DNS rebinding: a hostile page whose own name is made to resolve to this LAN address would be
# same-origin with the plan page (all health data, and /api/food/* read + write). So every request
# must name this server by an IP literal (v4 or bracketed v6), localhost, or a name listed in
# PLAN_WEB_EXTRA_HOSTS (rendered by hosts.sh into the included file, empty by default); anything else
# gets 421 before any location runs. $host is already lowercased and without the port.
map $host $hc_host_ok {
    default 0;
    localhost 1;
    "~^[0-9]{1,3}(\.[0-9]{1,3}){3}$" 1;
    "~^\[[0-9a-f:.]+\]$" 1;
    include /etc/nginx/hc-extra-hosts.map;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    if ($hc_host_ok = 0) { return 421; }

    # Path normalization: an SSO proxy in front may match its bypass rules (/ingest/*, /api/sync)
    # on the RAW path while nginx serves the normalized one (/ingest/%2e%2e/index.html would be the
    # page). No legitimate path here has a dot-segment, an encoded dot / slash / backslash or an
    # empty segment, so refuse them in the raw path (the query string is not checked).
    if ($request_uri ~* "^[^?]*(\.\.|%2e|%2f|%5c|//)") { return 400; }

    # Always revalidate: the page is regenerated hourly and on demand.
    add_header Cache-Control "no-cache";

    # The page is one self-contained HTML file (inlined CSS / JS / data, a few hundred KB) that
    # compresses well. text/html is always compressed once gzip is on, so it is not listed. The
    # proxied ingest routes below turn it off: their responses reflect request input next to stored
    # data (a BREACH-style length oracle) and are small anyway.
    # RULE: every block that proxies to ingest MUST set `gzip off;` (scripts/plan-web-config.test.mjs fails otherwise).
    gzip on;
    gzip_types text/css application/javascript application/json;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_vary on;

    # Written by refresh.sh after every publish; the page polls it after a Sync.
    location = /status.json {
        default_type application/json;
        add_header Cache-Control "no-cache, no-store";
    }

    # Ingest routes reachable from here, all unauthenticated by design (the
    # page is a static file and cannot hold a secret):
    #   - on-demand refresh, EXACTLY two routes: POST /sync coalesces repeated
    #     clicks and returns a sequence number; status returns timestamps,
    #     sequence numbers and coarse error codes, never health data or raw
    #     errors;
    #   - the food log, /api/food/* -> ingest /food/* (products, recipes, the
    #     daily log, the Open Food Facts lookup). With the Host map above, the
    #     service's own Host / Origin checks and its required X-HC-Food header +
    #     JSON body (a CORS preflight it never approves), a website opened in a
    #     LAN browser can neither read nor write it. Anything on the LAN that
    #     talks to it directly can: LAN only, never publish this server.
    #   - the behaviour journal, /api/journal/* -> ingest /journal/* (day,
    #     summary, settings), the same layers with its own X-HC-Journal header.
    # Plus ONE bearer-protected route, for the iOS Shortcut when this server is
    # the public entry (an SSO tunnel that bypasses exactly /ingest/* and
    # /api/sync): POST /ingest/health-auto-export, exact match. ingest checks
    # the INGEST_TOKEN itself. The data export endpoints (/export/*), the
    # Strava pull (/sync/strava) and every other /ingest/* path are never
    # proxied: they, and everything else under /api/, are a 404.
    location = /api/sync {
        gzip off;
        limit_except POST { deny all; }
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_pass http://host.docker.internal:${INGEST_PORT}/sync;
    }

    location = /api/sync/status {
        gzip off;
        limit_except GET { deny all; }
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_pass http://host.docker.internal:${INGEST_PORT}/sync/status;
    }

    location /api/food/ {
        gzip off;
        limit_except GET POST PUT DELETE { deny all; }
        client_max_body_size 16k;
        proxy_set_header X-HC-Food $http_x_hc_food;
        # the hop's Host: a name the ingest Host check accepts (the browser's Origin is passed on)
        proxy_set_header Host host.docker.internal;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_pass http://host.docker.internal:${INGEST_PORT}/food/;
    }

    location /api/journal/ {
        gzip off;
        limit_except GET PUT { deny all; }
        client_max_body_size 16k;
        proxy_set_header X-HC-Journal $http_x_hc_journal;
        # the hop's Host: a name the ingest Host check accepts (the browser's Origin is passed on)
        proxy_set_header Host host.docker.internal;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_pass http://host.docker.internal:${INGEST_PORT}/journal/;
    }

    location = /ingest/health-auto-export {
        gzip off;
        limit_except POST { deny all; }
        # no Bearer token: refuse before reading (or buffering) any body; ingest checks the token itself
        if ($http_authorization !~* "^Bearer\s+\S+") { return 401; }
        # a Shortcut payload is a few hundred KB; stays below health-ingest's MAX_BODY_BYTES default (32 MB)
        client_max_body_size 8m;
        # a Shortcut payload is a few hundred KB: keep it in memory, not a temp file
        client_body_buffer_size 1m;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Automation-Name $http_automation_name;
        proxy_set_header Content-Type $content_type;
        proxy_set_header Host host.docker.internal;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_pass http://host.docker.internal:${INGEST_PORT}/ingest/health-auto-export;
    }

    location /api/ {
        return 404;
    }

    # Device manuals (profile.json devices[].manual), copied from data/gear/ by refresh.sh
    # (scripts/publish-manuals.mjs) into ./site/manuales/. Only a bare file name with the publisher's
    # own pattern (lib/profile/profile.mjs MANUAL_FILE_RE) is served, always as an inline PDF that the
    # browser must not sniff into anything else; no listing, nothing else under /manuales/. Static
    # files: the Host and raw-path guards above apply; behind an SSO tunnel this stays behind SSO.
    location ~ "^/manuales/[A-Za-z0-9][A-Za-z0-9._-]{0,120}\.pdf$" {
        limit_except GET { deny all; }
        autoindex off;
        types { }
        default_type application/pdf;
        add_header X-Content-Type-Options nosniff always;
        # Not `sandbox`: a CSP-sandboxed document may not load plugins, and browsers' built-in PDF
        # viewers run as one (Chromium shows a blocked page). This keeps a crafted PDF from running
        # anything but the same-origin PDF viewer embed.
        add_header Content-Security-Policy "default-src 'none'; object-src 'self'" always;
        add_header Content-Disposition inline always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location /manuales/ {
        return 404;
    }
}
