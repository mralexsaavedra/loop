# Generate with: openssl rand -hex 32
INGEST_TOKEN=replace-me-with-64-hex-chars

POSTGRES_PASSWORD=replace-me
POSTGRES_USER=health
POSTGRES_DB=health

# Host port the service listens on; point your reverse proxy (if any) here. Required.
INGEST_PORT=8088
# Optional: publish the port on this host address only (the LAN IP, or 127.0.0.1). Docker ignores ufw /
# firewalld for published ports, so set it on a host with a public address. Empty = every address.
# INGEST_BIND=192.168.1.10

# Optional: the published image tag `docker compose pull` uses (default: this clone's release version).
# `docker compose up -d --build` ignores it and builds from the clone.
# HC_VERSION=x.y.z

# Strava API v3 — create an application at https://www.strava.com/settings/api
# Leave blank to run Apple Health ingestion only.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_SYNC_MINUTES=30
