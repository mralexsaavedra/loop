{
  "name": "health-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling for the plan single source of truth (data/nutrition + data/training) and its Astro build (web/).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node data/nutrition/generate.js && node scripts/build-web.mjs",
    "check": "node data/nutrition/generate.js --check && node scripts/build-web.mjs --check",
    "build": "node scripts/build-web.mjs",
    "build:example": "node scripts/build-web.mjs --mode example --locale en",
    "pretest": "node web/test/build-fixtures.mjs",
    "test": "node --test \"lib/**/*.test.mjs\" \"web/**/*.test.mjs\" \"scripts/*.test.mjs\" data/nutrition/*.test.js data/training/*.test.js data/apple-health/*.test.js",
    "sync": "node data/apple-health/sync-shortcut.js"
  },
  "dependencies": {
    "astro": "7.3.5"
  }
}
