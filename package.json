{
  "name": "loop",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling for the plan single source of truth (data/nutrition + data/training) and its Astro build (web/).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "node data/nutrition/generate.mjs && node scripts/build-web.mjs",
    "check": "node data/nutrition/generate.mjs --check && node scripts/build-web.mjs --check",
    "build": "node scripts/build-web.mjs",
    "build:example": "node scripts/build-web.mjs --mode example --locale en",
    "gen:food-calc": "node scripts/gen-food-calc.mjs",
    "gen:journal-calc": "node scripts/gen-journal-calc.mjs",
    "demo:data": "node scripts/make-demo-data.mjs",
    "golden:bake": "node scripts/golden-bake.mjs",
    "pretest": "node web/test/build-fixtures.mjs",
    "test": "node --test \"lib/**/*.test.mjs\" \"web/**/*.test.mjs\" \"scripts/*.test.mjs\" \".claude/hooks/*.test.js\" data/nutrition/*.test.mjs data/apple-health/*.test.mjs data/profile/*.test.mjs",
    "test:services": "npm --prefix services/loop-ingest ci --no-audit --no-fund && npm --prefix services/loop-ingest test",
    "test:css:update": "node scripts/update-css-fixture.mjs",
    "sync": "node scripts/sync-all.mjs",
    "sync:shortcut": "node data/apple-health/sync-shortcut.mjs",
    "sync:strava": "node data/apple-health/sync-strava.mjs",
    "sync:profile": "node data/profile/sync-profile.mjs",
    "publish:manuals": "node scripts/publish-manuals.mjs",
    "sync:settings": "node data/profile/sync-settings.mjs",
    "sync:onboarding": "node scripts/sync-onboarding.mjs",
    "sync:foodlog": "node data/nutrition/sync-foodlog.mjs"
  },
  "dependencies": {
    "astro": "7.3.5",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "subset-font": "^2.9.0"
  }
}
