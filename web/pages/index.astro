---
/* Entry page for the Astro build. Loads the env contract (locale/data-mode/inputs) at build
 * time, computes the nutrition + training + health view-models, and composes the shared Plan
 * layout with FOUR top-level tabs, one question each (Whoop-style):
 *   - Inicio/Home (`home`)          today: dials, monitor, advice + "today you eat" card + programmed session (hoy)
 *   - Entreno/Training (`entreno`)  load (load), calendar (calendar), run/ride tables (sessions), dashboard (dash)
 *   - Salud/Health (`health`)       health monitor, recovery, fitness, sleep, body, activity, energy
 *   - Nutrición (`nutricion`)       today (dia: Resumen de hoy + Plan de hoy + Registrar + Avituallamiento)
 *                                   + Mis productos / Mis recetas (LAN only, with dia) + Tablas (tablas)
 * The former tab keys now name sections; `page.hideTabs` hides a section by its legacy key and a
 * tab by its top-level key (lib/nav/tabs.mjs resolveNav); `registro` (the removed day builder) is a
 * deprecated no-op. The shared <Bake> renders once, after the panels, whatever is hidden.
 * See spec: plan-web-single-file-build.
 */
import Plan from '../layouts/Plan.astro';
import Home from '../src/tabs/Home.astro';
import Dia from '../src/tabs/Dia.astro';
import Bake from '../src/components/Bake.astro';
import Tablas from '../src/tabs/Tablas.astro';
import Food from '../src/tabs/Food.astro';
import Hoy from '../src/tabs/Hoy.astro';
import Entrenos from '../src/tabs/Entrenos.astro';
import TrainingDetail from '../src/tabs/TrainingDetail.astro';
import Salud from '../src/tabs/Salud.astro';
import { resolveEnv } from '../src/env.mjs';
import { computeBakes } from '../src/bakes.mjs';
import { getDict } from '../src/i18n/index.mjs';
import { trainingMeta } from '../../lib/training/program.mjs';
import { resolveNav, activeTabKey, TAB_KEYS, sectionsOf } from '../../lib/nav/tabs.mjs';
import DetailSheet from '../src/components/DetailSheet.astro';

const env = resolveEnv();
const { locale, plan, training } = env;
const dict = getDict(locale);
const trainMeta = trainingMeta(training);
// every extract-dependent view-model (and the nutrition model the intake rings share), in one
// Astro-free function the golden guard runs too (web/src/bakes.mjs)
const { nut, dash, activity, health, profile, scores, detail, intake } = computeBakes(env);

const navTab = (key: string) => ({ key, label: dict.strings.nav.tabs[key].label });
// `sections` = the section keys a tab is made of ENTIRELY (hiding all of them drops the tab):
// Nutrición and Entreno; Inicio and Salud hold blocks beyond their sections.
const SECTION_ONLY_TABS = ['entreno', 'nutricion'];
const TABS_ALL = TAB_KEYS.map((key) => (SECTION_ONLY_TABS.includes(key) ? { ...navTab(key), sections: sectionsOf(key) } : navTab(key)));
// hideTabs removes a NAV BUTTON (top-level key) or renders a SECTION `hidden` (legacy key); panels
// and sections always render. The visible panel is the first tab of the FILTERED list; throws if
// every tab is hidden.
const hideTabs = plan.page?.hideTabs;
const { tabs: TABS, hiddenSections } = resolveNav(TABS_ALL, hideTabs);
const activeTab = activeTabKey(TABS);
const isHidden = (key: string) => hiddenSections.includes(key);
const isTabVisible = (key: string) => TABS.some((t) => t.key === key);

const title = plan.page?.title || 'Plan';
---

<Plan title={title} locale={locale} page={plan.page} dict={dict} tabs={TABS} activeTab={activeTab} profile={profile}>
  <div class="tab-panel" data-tab="home" hidden={activeTab !== 'home'}>
    <Home locale={locale} eatLink={isTabVisible('nutricion')} />
    <Hoy dict={dict} hidden={isHidden('hoy')} />
  </div>
  <div class="tab-panel" data-tab="entreno" hidden={activeTab !== 'entreno'}>
    <TrainingDetail activity={activity} locale={locale} hidden={{ load: isHidden('load'), calendar: isHidden('calendar'), sessions: isHidden('sessions') }} />
    <Entrenos hidden={isHidden('dash')} />
  </div>
  <div class="tab-panel" data-tab="health" hidden={activeTab !== 'health'}>
    <Salud locale={locale} />
  </div>
  <div class="tab-panel" data-tab="nutricion" hidden={activeTab !== 'nutricion'}>
    <Dia nut={nut} plan={plan} locale={locale} page={plan.page} hidden={isHidden('dia')} intakeHost={!!intake.latest} supplements={profile.supplements} weight={profile.weight} sports={env.onboarding?.sports} />
    {!isHidden('dia') && <Food locale={locale} />}
    <Tablas nut={nut} dict={dict} locale={locale} page={plan.page} hidden={isHidden('tablas')} />
  </div>
  <Bake locale={locale} training={training.days} trainingMeta={trainMeta} dash={dash} health={health} scores={scores} intake={intake} />
  <DetailSheet slot="overlay" detail={detail} locale={locale} />
</Plan>
