---
/* Shared page shell — header (personal copy), tab nav + day toggle, footer
 * (personal copy), and the end-of-body script order per design: bake (each
 * tab's own Bake, e.g. Registro's) → NAV + HC_CONST → util (window.HC, the shared client helpers,
 * FIRST so every later script can read it) → core (setTab/jump/bump) →
 * nutrition → nutri-day → intake → training-today → training-dash → training-activity → health → score → monitor → timeline → profile → detail → freshness.
 * Tabs render inside <slot />; the detail sheet (components/DetailSheet.astro) renders in the `overlay`
 * slot, after .wrap, so detail.js can make the page behind it inert. The top bar is ONE row on phones: date · status dot + short
 * freshness (#fresh-sum, per-source detail in the #fresh-pop popover) · icon-only Sync · avatar. #freshness renders hidden; freshness.js
 * shows it only when the page's server answers /api/sync/status (see services/plan-web/README.md).
 */
import '../src/styles/tokens.css';
import '../src/styles/base.css';
import '../src/styles/dia.css';
import '../src/styles/nutri.css';
import '../src/styles/registro.css';
import '../src/styles/tablas.css';
import '../src/styles/training.css';
import '../src/styles/health.css';
import '../src/styles/score.css';
import '../src/styles/layout.css';
import '../src/styles/detail.css';
import '../src/styles/profile.css';
import utilScript from '../src/client/util.js?raw';
import coreScript from '../src/client/core.js?raw';
import nutritionScript from '../src/client/nutrition.js?raw';
import nutriDayScript from '../src/client/nutri-day.js?raw';
import trainingTodayScript from '../src/client/training-today.js?raw';
import trainingDashScript from '../src/client/training-dash.js?raw';
import trainingActivityScript from '../src/client/training-activity.js?raw';
import healthScript from '../src/client/health.js?raw';
import scoreScript from '../src/client/score.js?raw';
import monitorScript from '../src/client/monitor.js?raw';
import timelineScript from '../src/client/timeline.js?raw';
import intakeScript from '../src/client/intake.js?raw';
import freshnessScript from '../src/client/freshness.js?raw';
import detailScript from '../src/client/detail.js?raw';
import profileScript from '../src/client/profile.js?raw';
import Avatar from '../src/components/Avatar.astro';
import todayDateScript from '../src/client/today-date.js?raw';
import { es as esSync, en as enSync } from '../src/i18n/sync-templates.mjs';
import { es as esDate, en as enDate } from '../src/i18n/date-templates.mjs';
// Numerals font: a ~1.5 KB subset of D-DIN Bold (SIL OFL 1.1, renamed "HC Num" as the OFL requires
// for a modified version; licence in src/fonts/OFL.txt, rebuild with scripts/subset-num-font.py).
// `?inline` makes Vite hand back a base64 data: URL, so the page stays one self-contained file.
import numFontUrl from '../src/fonts/hc-num-bold.woff2?inline';
import { jsonForScript } from '../../lib/serialize.mjs';
import { TAB_KEYS, SECTION_TAB } from '../../lib/nav/tabs.mjs';
import { hcConst } from '../../lib/stale.mjs';

interface Props {
  title: string;
  locale: string;
  page?: {
    kicker?: string;
    h1?: string;
    sub?: string;
    footerHtml?: string;
  };
  dict: any;
  tabs: { key: string; icon: string; label: string }[];
  activeTab?: string;
  profile?: any; // lib/profile/profile.mjs loadProfile() result: the avatar button + the profile sheet
}

const { title, locale, page = {}, dict, tabs, activeTab = tabs[0]?.key, profile = null } = Astro.props;
// core.js reads the tab keys and the legacy-section map from this ONE baked copy of lib/nav/tabs.mjs
// ...and util.js reads the page-level constants (lib/stale.mjs) from HC_CONST, never client literals,
// and the names of its one date formatter (HC.fmtDate / HC.fmtMonth) from I18N_DATE
const syncT = locale === 'es' ? esSync : enSync;
const dateT = locale === 'es' ? esDate : enDate;
const navSource = `var NAV = ${jsonForScript({ tabs: TAB_KEYS, sectionTab: SECTION_TAB })};\nvar HC_CONST = ${jsonForScript(hcConst())};\nvar I18N_SYNC = ${jsonForScript(syncT)};\nvar I18N_DATE = ${jsonForScript(dateT)};`;
// unicode-range = exactly the subset's glyphs, so letters in a --num element fall back to --sans
const numFontFace = `@font-face{font-family:"HC Num";src:url(${numFontUrl}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap;unicode-range:U+20,U+25,U+2B-2E,U+30-39,U+68,U+D7}`;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <style is:inline set:html={numFontFace}></style>
  </head>
  <body>
    <div class="wrap">
      {/* page.h1 / page.sub are optional: without them the page opens straight onto the dials and a
          visually hidden h1 (the page title) keeps one h1 in the document */}
      {(page.kicker || page.h1 || page.sub) && (
        <header>
          {page.kicker && <div class="kicker">{page.kicker}</div>}
          {page.h1 && <h1>{page.h1}</h1>}
          {page.sub && <p class="sub">{page.sub}</p>}
        </header>
      )}
      {!page.h1 && <h1 class="sr-only">{title}</h1>}

      {/* top bar: the viewer's date (client/today-date.js, nothing baked) + the freshness line / Sync +
          the avatar button that opens the profile sheet (components/Avatar.astro, client/profile.js) */}
      <div class="topbar">
        <time id="today-date" class="today-date"></time>
        <div class="fresh" id="freshness" role="group" aria-label={syncT.ariaLabel} hidden>
          <button type="button" class="fresh-sum" id="fresh-sum" aria-expanded="false" aria-controls="fresh-pop"><span class="fresh-dot" aria-hidden="true"></span><span class="fresh-short" id="fresh-short"></span></button>
          <button type="button" class="fresh-btn" id="sync-btn" aria-label={syncT.button} title={syncT.button}><svg class="fresh-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-14.3 4.9M4 12a8 8 0 0 1 14.3-4.9" /><path d="M18.5 3v4.2h-4.2M5.5 21v-4.2h4.2" /></svg></button>
          <div class="fresh-pop" id="fresh-pop" hidden><p class="fresh-line" id="fresh-line"></p></div>
          <p class="fresh-msg" id="sync-msg" role="status" aria-live="polite"></p>
        </div>
        {profile && <Avatar profile={profile} locale={locale} />}
      </div>

      <nav class="tabnav" role="tablist" aria-label={dict.strings.nav.ariaLabel}>
        {tabs.map((tab) => (
          <button
            id={`t-${tab.key}`}
            role="tab"
            aria-pressed={tab.key === activeTab}
            onclick={`setTab('${tab.key}')`}
          >
            <span class="tico">{tab.icon}</span><span class="tlbl">{tab.label}</span>
          </button>
        ))}
      </nav>

      <slot />

      {page.footerHtml && (
        <footer set:html={page.footerHtml} />
      )}
    </div>
    <slot name="overlay" />
    <script is:inline set:html={navSource} />
    <script is:inline set:html={utilScript} />
    <script is:inline set:html={coreScript} />
    <script is:inline set:html={todayDateScript} />
    <script is:inline set:html={nutritionScript} />
    <script is:inline set:html={nutriDayScript} />
    <script is:inline set:html={intakeScript} />
    <script is:inline set:html={trainingTodayScript} />
    <script is:inline set:html={trainingDashScript} />
    <script is:inline set:html={trainingActivityScript} />
    <script is:inline set:html={healthScript} />
    <script is:inline set:html={scoreScript} />
    <script is:inline set:html={monitorScript} />
    <script is:inline set:html={timelineScript} />
    <script is:inline set:html={profileScript} />
    <script is:inline set:html={detailScript} />
    <script is:inline set:html={freshnessScript} />
  </body>
</html>
