---
/* Shared page shell — header (personal copy), tab nav, footer
 * (personal copy), and the end-of-body script order per design: bake (the
 * shared Bake rendered by pages/index.astro, plus the per-tab bakes such as Dia's NUTRI) → NAV +
 * HC_CONST → HC_FMT + HC_BAND + HC_ADH + HC_PROG + HC_NSCORE + HC_FOODLOG + HC_DAYTYPE + HC_FUEL + HC_SCALE + HC_GUIDE (the one number formatter, lib/format/numbers.mjs clientSource; the recovery 0-100 bands, lib/score/recovery.mjs clientSource; every nutrition global — food log adherence, weight progress, nutrition score, food log formula, day type, ride fuelling, portion scaling and guide — lib/nutrition/client.mjs clientSource) →
 * every web/src/client/*.js in the order of src/client/manifest.mjs (util FIRST, … detail → freshness; each entry
 * states what it provides and requires at load, web/test/script-manifest.test.mjs keeps it true).
 * Tabs render inside <slot />; the detail sheet (components/DetailSheet.astro) renders in the `overlay`
 * slot, after .wrap, so detail.js can make the page behind it inert (the dock and the "+" popover sit inside .wrap). The top bar
 * is ONE row: avatar · centred "‹ Today ›" date pill (client/today-date.js steps Inicio through past days) · status dot + short freshness (#fresh-sum, per-source detail in the #fresh-pop
 * popover) + icon-only Sync. #freshness renders hidden; freshness.js shows it only when the page's server answers /api/sync/status
 * (see services/loop-web/README.md).
 */
import '../src/styles/tokens.css';
import '../src/styles/base.css';
import '../src/styles/dia.css';
import '../src/styles/nutri.css';
import '../src/styles/tablas.css';
import '../src/styles/training.css';
import '../src/styles/health.css';
import '../src/styles/score.css';
import '../src/styles/layout.css';
import '../src/styles/detail.css';
import '../src/styles/profile.css';
import '../src/styles/food.css';
import '../src/styles/journal.css';
import { clientSource as fmtClientSource } from '../../lib/format/numbers.mjs';
import { clientSource as bandClientSource } from '../../lib/score/recovery.mjs';
import { clientSource as nutriClientSource } from '../../lib/nutrition/client.mjs';
import { CLIENT_SCRIPTS } from '../src/client/manifest.mjs';
// the raw source of every client script, keyed by path; inlined in CLIENT_SCRIPTS order below (the
// markup keeps </body> on the map's line: a line break after an expression renders as a space)
const clientSources = import.meta.glob('../src/client/*.js', { query: '?raw', import: 'default', eager: true });
import Avatar from '../src/components/Avatar.astro';
import tokensCss from '../src/styles/tokens.css?raw';
import { es as esSync, en as enSync } from '../src/i18n/sync-templates.mjs';
import { es as esDate, en as enDate } from '../src/i18n/date-templates.mjs';
// Numerals font: a ~1.5 KB subset of D-DIN Bold (SIL OFL 1.1, renamed "HC Num" as the OFL requires
// for a modified version; licence in src/fonts/OFL.txt, rebuild with scripts/subset-num-font.py).
// `?inline` makes Vite hand back a base64 data: URL, so the page stays one self-contained file.
import numFontUrl from '../src/fonts/hc-num-bold.woff2?inline';
// Text font: "HC Text" = a ~26 KB subset of Inter (variable, weights 400-800, SIL OFL 1.1, no Reserved
// Font Name; licence in src/fonts/OFL-Inter.txt, rebuild with scripts/subset-text-font.mjs), inlined the
// same way. Its unicode-range comes from the one code-point list the subset script also reads.
import textFontUrl from '../src/fonts/hc-text.woff2?inline';
import { unicodeRange as textUnicodeRange } from '../src/fonts/text-font-ranges.mjs';
// LOOP icons (generated by scripts/make-logo.mjs, never hand-edited): the 32 px tile SVG as the favicon
// and the 180×180 full-square PNG as the home-screen icon (iOS rounds its corners), both data: URIs so
// the page stays one self-contained file
import faviconSvg from '../src/assets/loop-favicon.svg?raw';
import touchIconUrl from '../src/assets/loop-touch-icon.png?inline';
// the wordmark in the top bar (every tab: centred on the phone, on the left from 900px)
import wordmarkSvg from '../src/assets/loop-wordmark.svg?raw';
import { jsonForScript } from '../../lib/serialize.mjs';
import { TAB_KEYS, SECTION_TAB, DETAIL_TAB, VIEW_TAB, ANCHOR_TAB, DAY_HASH } from '../../lib/nav/tabs.mjs';
import { hcConst } from '../../lib/stale.mjs';
// every client script is inlined through slimScript (comments + whitespace out, names and syntax kept)
import { slimScript } from '../src/slim-script.mjs';

interface Props {
  title: string;
  locale: string;
  page?: {
    kicker?: string;
    h1?: string;
    sub?: string;
    footerHtml?: string;
  };
  dict: any;
  tabs: { key: string; label: string }[];
  activeTab?: string;
  profile?: any; // lib/profile/read.mjs loadProfile() result: the avatar button + the profile sheet
}

const { title, locale, page = {}, dict, tabs, activeTab = tabs[0]?.key, profile = null } = Astro.props;
// the document title (browser tab, home-screen name) is the product name; the personal page.title only
// names the visually hidden h1 when page.h1 is absent
const brand = dict.strings.brand;
const faviconUrl = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
const nav = dict.strings.nav;
// tab icons: 24-unit line icons (stroke = currentColor, the same drawing as Nutrición's day-type
// icons) keyed by the top-level tab key; no emoji, no vendor icons
const TAB_ICONS: Record<string, string> = {
  home: '<path d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4z"/>',
  entreno: '<path d="M21 12h-4l-3 8-4-16-3 8H3"/>',
  health: '<path d="M12 20 4.6 12.7a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9a4.6 4.6 0 0 1 6.5 6.5z"/>',
  nutricion: '<path d="M7 3v18M4.5 3v5.5a2.5 2.5 0 0 0 5 0V3M17 21V3c-2 1.5-3.2 4.2-3.2 7.5V14H17"/>',
};
// the circular-arrows Sync icon: the top bar's Sync button and the "+" popover's Sync row
const SYNC_ICON = '<path d="M20 12a8 8 0 0 1-14.3 4.9M4 12a8 8 0 0 1 14.3-4.9"/><path d="M18.5 3v4.2h-4.2M5.5 21v-4.2h4.2"/>';
// the journal row of the "+" popover: a notebook with a check
const JOURNAL_ICON = '<path d="M6 3h12v18H6zM9 3v18"/><path d="m12 12 2 2 3-4"/>';
// core.js reads the tab keys and the legacy-section map (+ the deep-link host tabs) from this ONE baked copy of lib/nav/tabs.mjs
// ...and util.js reads the page-level constants (lib/stale.mjs) from HC_CONST, never client literals,
// and the names of its one date formatter (HC.fmtDate / HC.fmtMonth) from I18N_DATE
const syncT = locale === 'es' ? esSync : enSync;
const dateT = locale === 'es' ? esDate : enDate;
// browser chrome (address / status bar) tinted like the TOP of the page background: read from the
// --ground-top token, the one copy (web/test/mobile.test.mjs pins the built meta to it)
const themeColor = /--ground-top:\s*(#[0-9a-fA-F]{6})\s*;/.exec(tokensCss)?.[1];
if (!themeColor) throw new Error('tokens.css: --ground-top must be a #rrggbb colour (theme-color meta)');
const navSource = `var NAV = ${jsonForScript({ tabs: TAB_KEYS, sectionTab: SECTION_TAB, detailTab: DETAIL_TAB, viewTab: VIEW_TAB, anchorTab: ANCHOR_TAB, day: DAY_HASH })};\nvar HC_CONST = ${jsonForScript(hcConst())};\nvar I18N_SYNC = ${jsonForScript(syncT)};\nvar I18N_DATE = ${jsonForScript(dateT)};`;
// unicode-range = exactly the subset's glyphs, so letters in a --num element fall back to --sans
const numFontFace = `@font-face{font-family:"HC Num";src:url(${numFontUrl}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap;unicode-range:U+20,U+25,U+2B-2E,U+30-39,U+68,U+D7}`;
const textFontFace = `@font-face{font-family:"HC Text";src:url(${textFontUrl}) format("woff2");font-weight:400 800;font-style:normal;font-display:swap;unicode-range:${textUnicodeRange()}}`;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />
    <title>{brand}</title>
    <meta name="apple-mobile-web-app-title" content={brand} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={touchIconUrl} />
    <style is:inline set:html={numFontFace + textFontFace}></style>
  </head>
  <body>
    <div class="wrap">
      {/* no hero header (navigation shell, 2026-10): the page opens on the top bar and the dials.
          page.h1 (else the page title) is the ONE h1, visually hidden; page.kicker / page.sub are
          accepted by the validator but no longer drawn */}
      <h1 class="sr-only">{page.h1 || title}</h1>

      {/* top bar, on every tab: the avatar button that opens the profile sheet (components/Avatar.astro,
          client/profile.js) · the LOOP wordmark: the generated outlines of src/assets/loop-wordmark.svg
          (scripts/make-logo.mjs), inlined; letters and the first ring are --ink, the second ring's arcs
          --sleep / --good / --strain (layout.css) · a "‹ Today ›" date pill, Inicio only (layout.css; the
          viewer's full date is the <time> inside, filled by client/today-date.js, nothing baked; the chevrons step Inicio through the
          baked past days and ship hidden: the script shows them only when a past day is in reach; a
          past day's date replaces "Today" and the label then returns to today) · the freshness line /
          Sync on the right. It is the page's <header> (banner landmark). Phone: avatar · LOOP · Sync on one row, the pill on a second; from 900px
          LOOP left · pill centre · Sync + avatar right, one row */}
      <header class="topbar">
        {profile && <Avatar profile={profile} locale={locale} />}
        {/* the wordmark is THE way home: a tap opens the default tab (Inicio unless hidden), scrolled to the top */}
        <button type="button" class="wordmark" data-tab-go="" aria-label={nav.homeLink} set:html={wordmarkSvg.trim()}></button>
        <div class="date-pill" id="date-pill" role="group" aria-label={nav.day.group}>
          <button type="button" class="day-step" id="day-prev" aria-label={nav.day.prev} hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" /></svg></button>
          <button type="button" class="day-lbl" id="day-lbl" aria-disabled="true" data-back={nav.day.back}><span class="date-pill-lbl" id="day-word" aria-hidden="true">{nav.today}</span><time id="today-date" class="today-date"></time></button>
          <button type="button" class="day-step" id="day-next" aria-label={nav.day.next} hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6" /></svg></button>
          <span class="sr-only" id="day-live" role="status" aria-live="polite"></span>
        </div>
        <div class="fresh" id="freshness" role="group" aria-label={syncT.ariaLabel} hidden>
          <button type="button" class="fresh-sum" id="fresh-sum" aria-expanded="false" aria-controls="fresh-pop"><span class="fresh-dot" aria-hidden="true"></span><span class="fresh-short" id="fresh-short"></span></button>
          <button type="button" class="fresh-btn" id="sync-btn" aria-label={syncT.button} title={syncT.button}><svg class="fresh-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={SYNC_ICON} /></button>
          <div class="fresh-pop" id="fresh-pop" hidden><p class="fresh-line" id="fresh-line"></p></div>
          <p class="fresh-msg" id="sync-msg" role="status" aria-live="polite"></p>
        </div>
      </header>

      {/* bottom dock (floating, every width): the tab bar (a labelled nav of plain buttons, the shown
          tab's aria-current="page"; client/core.js moves it) + to its right the "+" action button. The
          "+" is outside the nav; it and every action ship hidden and client/nav-actions.js shows
          only what this page can really do (add food / Sync, both LAN only) */}
      <div class="dock">
        <nav class="tabnav" aria-label={nav.ariaLabel}>
          {tabs.map((tab) => (
            <button
              type="button"
              id={`t-${tab.key}`}
              data-tab-go={tab.key}
              aria-current={tab.key === activeTab ? 'page' : undefined}
            >
              <svg class="tico" viewBox="0 0 24 24" aria-hidden="true" set:html={TAB_ICONS[tab.key] || ''} /><span class="tlbl">{tab.label}</span>
            </button>
          ))}
        </nav>
        <div class="act" id="act" hidden>
          <button type="button" class="act-btn" id="act-btn" aria-expanded="false" aria-controls="act-pop" aria-label={nav.actions.open} data-label-close={nav.actions.close}><svg class="act-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
          <div class="act-pop" id="act-pop" role="group" aria-label={nav.actions.label} hidden>
            <button type="button" class="act-item" data-act="food" hidden><svg class="act-item-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={TAB_ICONS.nutricion} /><span>{nav.actions.addFood}</span></button>
            <button type="button" class="act-item" data-act="journal" hidden><svg class="act-item-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={JOURNAL_ICON} /><span>{nav.actions.journal}</span></button>
            <button type="button" class="act-item" data-act="sync" hidden><svg class="act-item-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={SYNC_ICON} /><span>{nav.actions.sync}</span></button>
          </div>
        </div>
      </div>
      <div class="act-scrim" id="act-scrim" hidden></div>

      {/* the page's main landmark: the four tab panels (pages/index.astro), each a region named by its nav button */}
      <main class="panels">
        <slot />
      </main>

      {page.footerHtml && (
        <footer set:html={page.footerHtml} />
      )}
    </div>
    <slot name="overlay" />
    <script is:inline set:html={navSource} />
    <script is:inline set:html={slimScript(fmtClientSource() + '\n' + bandClientSource() + '\n' + nutriClientSource())} />
    {CLIENT_SCRIPTS.map(({ file }) => <script is:inline set:html={slimScript(clientSources[`../src/client/${file}`])} />)}</body>
</html>
