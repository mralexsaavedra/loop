---
/* "Entrenamiento / Workouts" (executed-workouts dashboard) — the last SECTION of the Entreno tab (it
 * was the "Entrenos" tab before the tab layout, then a section of Salud). Client-rendered entirely by
 * web/src/client/training-dash.js from DASH baked by <Bake> (the shared Bake in web/pages/index.astro).
 * `page.hideTabs: ["dash"]` renders it `hidden` (see Hoy.astro's header).
 */
interface Props {
  dict: any;
  hidden: boolean;
}
const { dict, hidden } = Astro.props;
---
<section class="tab-section" data-section="dash" id="sec-dash" hidden={hidden}>
  <h2>{dict.strings.nav.sections.dash}</h2>
  <div id="train-dash"></div>
</section>
