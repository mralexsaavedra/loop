---
/* "Intensity (HR)" — the last SECTION of the Entreno tab (key `dash`: it was the "Entrenos" tab
 * before the tab layout, then the executed-workouts dashboard; its weekly volume, modality split and
 * summary cards merged into the Activity card, TrainingDetail.astro's `calendar` section). What is
 * left is the mean HR per modality, client-rendered by web/src/client/training-dash.js from DASH baked
 * by <Bake> (the shared Bake in web/pages/index.astro), header + ⓘ included.
 * `page.hideTabs: ["dash"]` renders it `hidden`.
 */
interface Props {
  hidden: boolean;
}
const { hidden } = Astro.props;
---
<section class="tab-section" data-section="dash" id="sec-dash" hidden={hidden}>
  <div id="train-dash"></div>
</section>
