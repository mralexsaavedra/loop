---
/* "Entrenamiento / Training" (executed-workouts dashboard) — a SECTION of the Salud/Health tab (it
 * was the "Entrenos" tab before the three-tab layout). Client-rendered entirely by
 * web/src/client/training-dash.js from DASH baked by <Bake> (see web/src/tabs/Registro.astro).
 * `page.hideTabs: ["dash"]` renders it `hidden` (see Hoy.astro's header).
 */
interface Props {
  dict: any;
  hidden: boolean;
}
const { dict, hidden } = Astro.props;
---
<section class="tab-section" data-section="dash" id="sec-dash" hidden={hidden}>
  <h2>{dict.strings.nav.sections.dash}</h2>
  <div id="train-dash"></div>
</section>
