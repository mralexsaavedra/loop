---
/* "Entrenos" (executed-workouts dashboard) tab — ported verbatim from the
 * legacy `data-tab="dash"` panel in data/nutrition/plan-web.html.
 * Client-rendered entirely by web/src/client/training-dash.js from DASH
 * baked by <Bake> (see web/src/tabs/Registro.astro). See Hoy.astro's
 * header for the shared hideTabs/Bake-placement notes.
 */

interface Props {
  activeTab: string;
}
const { activeTab } = Astro.props;
---
<div class="tab-panel" data-tab="dash" hidden={activeTab !== 'dash'}>
  <div id="train-dash"></div>
</div>
