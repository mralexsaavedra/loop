---
/* "Hoy" (today's programmed training session) — a SECTION of the Inicio/Home tab (it was a tab of
 * its own before the four-tab layout). Client-rendered entirely by
 * web/src/client/training-today.js from TRAINING/TRAINING_META baked by <Bake> (see
 * web/pages/index.astro, which hosts the shared Bake call).
 *
 * `page.hideTabs: ["hoy"]` renders this section `hidden` (see lib/nav/tabs.mjs resolveNav) — the
 * markup, its baked globals and its client script always stay in the build.
 */
interface Props {
  dict: any;
  hidden: boolean;
}
const { dict, hidden } = Astro.props;
---
<section class="tab-section" data-section="hoy" id="sec-hoy" hidden={hidden}>
  <h2>{dict.strings.nav.sections.hoy}</h2>
  <div id="train-today"></div>
</section>
