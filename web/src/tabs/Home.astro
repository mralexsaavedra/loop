---
/* "Inicio / Home" tab: recovery trend + per-modality load + advice. Client-rendered entirely by
 * web/src/client/score.js from SCORES baked by <Bake> (see Registro.astro, which hosts the shared
 * Bake call). The panel's `hidden` is derived from the FILTERED nav list (activeTab) so
 * page.hideTabs can never leave a visible panel without a nav button (spec R7.1).
 */
interface Props {
  activeTab: string;
}
const { activeTab } = Astro.props;
---
<div class="tab-panel" data-tab="home" hidden={activeTab !== 'home'}>
  <div id="home"></div>
</div>
