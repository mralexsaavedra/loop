---
/* "Mi día" — first section of the Nutrición/Nutrition tab (a tab of its own before the three-tab
 * layout); ported from the legacy GEN:DAYPLAN region + its trailing
 * hand-written footnote (data/nutrition/plan-web.html), server-rendered
 * from lib/nutrition/macros.mjs's buildNutrition() output instead of a
 * generated HTML string. See spec: plan-web-single-file-build (tab parity).
 */
import DayPanel from '../components/DayPanel.astro';
import Note from '../components/Note.astro';
import { dayViewModel } from '../view/day-totals.mjs';

interface Props {
  nut: any; // buildNutrition() result
  dict: any;
  hidden: boolean; // page.hideTabs includes "dia"
  page?: { notes?: Record<string, string> };
}
const { nut, dict, page, hidden } = Astro.props;

const train = dayViewModel(nut, 'train');
const rest = dayViewModel(nut, 'rest');
---
<section class="tab-section" data-section="dia" id="sec-dia" hidden={hidden}>
  <DayPanel day={train.day} meals={train.meals} totals={train.totals} kcalNote={train.kcalNote} hidden={false} dict={dict} />
  <DayPanel day={rest.day} meals={rest.meals} totals={rest.totals} kcalNote={rest.kcalNote} hidden={true} dict={dict} />
  <Note
    id="dia.footnote"
    page={page}
    class="acc-note"
    style="border-top:1px solid var(--line);padding-top:14px;margin-top:18px"
  />
</section>
