---
/* First section of the Nutrición tab (section key `dia`, kept for page.hideTabs back-compat; it was
 * "Mi día"). Three blocks, top to bottom:
 *   1. Resumen de hoy  — day type (rest / gym / bike / bikeLong): a one-row segmented control of real
 *                        radios with inline SVG line icons and short labels (the detected type gets a
 *                        dot, .seg-auto); a 270° kcal dial (target centred, filled only from intake
 *                        logged today; the track is the Inicio dials' arc, baked as NUTRI_ARC), the goal
 *                        chip under it (the goal itself is set in the profile sheet, client/profile.js),
 *                        three macro bars (protein / carbs / fat), then the intake rings (#intake);
 *   2. Plan de hoy     — the day's meals with the carb-flex portions scaled to (goal × day type);
 *   3. Avituallamiento — before -> during -> after the ride as a 3-step timeline, bike day types only.
 * The day-type control is server-rendered (real labelled radios); the numbers
 * are client-rendered by client/nutri-day.js from NUTRI (lib/nutrition/today.mjs: the 12 precomputed
 * plans), baked here with I18N_NUTRI. Today's day type is picked on the viewer's clock, so builds
 * stay byte-identical.
 */
import Note from '../components/Note.astro';
import { jsonForScript } from '../../../lib/serialize.mjs';
import { buildNutriToday } from '../../../lib/nutrition/today.mjs';
import { es as esNutri, en as enNutri } from '../i18n/nutri-templates.mjs';
import { arcPath } from '../view/dial.mjs';

interface Props {
  nut: any; // buildNutrition() result
  plan: any;
  locale: string;
  hidden: boolean; // page.hideTabs includes "dia"
  page?: { notes?: Record<string, string> };
  intakeHost?: boolean; // false = no intake ever logged and the Registro fold summary carries the one-line hint
  supplements?: any[]; // profile.json supplements (lib/profile/profile.mjs)
  weight?: { kg: number; date: string } | null; // the latest weigh-in, for the g/kg fuelling amounts
}
const { nut, plan, locale, page, hidden, intakeHost = true, supplements = [], weight = null } = Astro.props;
const T = locale === 'es' ? esNutri : enNutri;
const es = locale === 'es';
const nutri = buildNutriToday(nut, plan, { supplements, weight, units: { g: 'g', ml: 'ml', ud: es ? 'ud' : 'pc' }, dec: es ? ',' : '.' });
const bake = `var NUTRI = ${jsonForScript(nutri)};\nvar I18N_NUTRI = ${jsonForScript(T)};\nvar NUTRI_ARC = ${jsonForScript(arcPath(0, 1))};`;
// simple 24-unit line icons for the day-type segments (stroke = currentColor; no emoji, no vendor icons)
const BIKE = '<circle cx="5.5" cy="16.5" r="3.5"/><circle cx="18.5" cy="16.5" r="3.5"/><path d="M5.5 16.5 9 9.5h6l3.5 7M9 9.5l3.5 7h-7M13 6.5h3l-1 3"/>';
const DAY_ICONS: Record<string, string> = {
  rest: '<path d="M3 6v13M3 15h18v4M21 15v-2.5a3 3 0 0 0-3-3h-7V15"/><circle cx="7" cy="12" r="1.8"/>',
  gym: '<path d="M6.5 7v10M17.5 7v10M3.5 9.5v5M20.5 9.5v5M6.5 12h11"/>',
  bike: BIKE,
  bikeLong: BIKE + '<path d="M5 2.5v5M2.5 5h5"/>',
};
---
<section class="tab-section" data-section="dia" id="sec-dia" hidden={hidden}>
  <div class="nutri-block" id="nutri-summary">
    <h2>{T.headings.summary}</h2>
    <div class="nutri-card">
      <fieldset class="seg" id="nutri-daytype">
        <legend class="seg-lbl">{T.dayLegend}<span class="seg-src" id="nutri-daytype-src"></span></legend>
        <div class="seg-opts">
          {nutri.dayTypes.map((d: string) => (
            <label class="seg-opt" title={T.dayTypes[d]}><input type="radio" name="nutri-day" value={d} /><span class="seg-in"><svg class="seg-ico" viewBox="0 0 24 24" aria-hidden="true" set:html={DAY_ICONS[d]} /><span class="seg-txt">{T.dayShort[d]}</span></span></label>
          ))}
        </div>
        <button type="button" class="lnk nutri-auto" id="nutri-auto" hidden></button>
        <p class="nutri-why" id="nutri-why"></p>
        <p class="nutri-why nutri-note" id="nutri-note" role="status" hidden></p>
      </fieldset>
      <div id="nutri-target" aria-live="polite"></div>
    </div>
    {/* intake rings: client-rendered by client/intake.js from INTAKE (baked in Registro's Bake) */}
    {intakeHost && <div id="intake"></div>}
  </div>

  <div class="nutri-block">
    <h2>{T.headings.plan}</h2>
    <div id="nutri-plan"></div>
  </div>

  <div class="nutri-block" id="nutri-fuel-block" hidden>
    <h2>{T.headings.fuel}</h2>
    <div class="nutri-card">
      <div id="nutri-ride-wrap"></div>
      <div id="nutri-fuel-body"></div>
    </div>
  </div>

  <Note
    id="dia.footnote"
    page={page}
    class="acc-note nutri-foot"
  />
</section>
<script is:inline set:html={bake}></script>
