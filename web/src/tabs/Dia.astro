---
/* Nutrición tab header + its first section (section key `dia`, kept for page.hideTabs back-compat; it
 * was "Mi día"). The header (outside the section, so it stays when only Tablas shows) is Salud /
 * Entreno's: the centred uppercase title + an ⓘ (#nu-intro) with the tab intro and shared caveats.
 * Blocks, top to bottom, each headed by the shared .hs-head row (UPPERCASE label + optional ⓘ):
 *   1. Resumen de hoy  — day type (rest / gym / bike / bikeLong): compact pills of real radios with
 *                        short labels (icons from 600 px; the detected type gets a dot, .seg-auto); the
 *                        kcal ring in the Inicio dial language (the full ring of view/dial.mjs, baked as
 *                        NUTRI_ARC; eaten today inside over "/ target", one state colour), the goal chip
 *                        under it (the goal itself is set in the profile sheet, client/profile.js), three
 *                        macro rows (protein / carbs / fat), then the intake rings (#intake, only with
 *                        intake logged in the last 3 days; otherwise nothing). The notes sit behind the
 *                        section's ⓘ (#nutri-sum-info, written by client/nutri-day.js);
 *   2. Registrar       — a day's food log by meal slot (a ‹ date › navigator, opens on today) + the add
 *                        sheet (client/food-*.js, docs/nutrition-food-log.md). Ships `hidden` and appears only on the LAN page, when the food API answers
 *                        (never in the claude.ai artifact or the example build); baked here: I18N_FOOD
 *                        + FOOD_CONST (meal slots / stores / units / input limits from lib/nutrition/foodlog.mjs)
 *                        + FOOD_BASICS (the public food DB as the add sheet's searchable basics,
 *                        lib/nutrition/basics.mjs, localized; also the portion guide's example foods);
 *   3. Plan de hoy     — a PORTION GUIDE (lib/nutrition/guide.mjs): always Desayuno, Comida, Cena +
 *                        Extras, each with today's budget (goal × day type × ride minutes) and, per
 *                        macro, one example food and its amount; in a native <details> COLLAPSED by
 *                        default (summary: heading + the meals target kcal, written by
 *                        client/nutri-day.js, which also remembers open / closed per viewer);
 *   4. Avituallamiento — before -> during -> after the ride as a 3-step timeline, bike day types only
 *                        (never collapsed);
 *   5. Balance         — intake vs expenditure (avg intake, avg burn, deficit / surplus a day) + the
 *                        average macro split over ONE baked window (client/health.js renderBalance,
 *                        HEALTH.energy);
 *   6. Progreso        — weight vs the goal (client/progress.js, from the baked DETAIL weight series;
 *                        the target weight on the LAN page), a tap opens the weight detail sheet;
 *   7. Constancia      — food log adherence over 7 / 14 / 28 days + a 28-day strip (client/adherence.js,
 *                        LAN page only: ships hidden until GET /api/food/log/summary answers).
 *   (between 5 and 6) Puntuación — the nutrition score card + 7 / 30-day averages (client/nutri-score.js;
 *                        hidden without a food log), a tap opens its trend sheet.
 * 5–7 follow the day's blocks on purpose: today's actions first, the multi-week look back after.
 * The day-type control is server-rendered (real labelled radios); the numbers
 * are client-rendered by client/nutri-day.js from NUTRI (lib/nutrition/today.mjs: the 12 precomputed
 * plans), baked here with I18N_NUTRI. Today's day type is picked on the viewer's clock, so builds
 * stay byte-identical.
 */
import Note from '../components/Note.astro';
import { jsonForScript } from '../../../lib/serialize.mjs';
import { buildNutriToday } from '../../../lib/nutrition/today.mjs';
import { personalNutriText, shownDayTypes } from '../i18n/day-labels.mjs';
import { es as esNutri, en as enNutri } from '../i18n/nutri-templates.mjs';
import { es as esFood, en as enFood } from '../i18n/food-templates.mjs';
import { FOOD_MEALS, FOOD_STORES, FOOD_UNITS, FOOD_LIMITS, SETTINGS_GOALS } from '../../../lib/nutrition/foodlog.mjs';
import { MEAL_GROUPS, MAIN_SLOTS, ADDON_GROUP, ADDON_SLOT, LATE_NIGHT_HOUR } from '../../../lib/nutrition/slots.mjs';
import { buildBasics } from '../../../lib/nutrition/basics.mjs';
import { arcPath } from '../view/dial.mjs';

interface Props {
  nut: any; // buildNutrition() result
  plan: any;
  locale: string;
  hidden: boolean; // page.hideTabs includes "dia"
  page?: { notes?: Record<string, string> };
  intakeHost?: boolean; // false = no intake ever logged: no rings host (intake.js also renders nothing for stale intake)
  supplements?: any[]; // profile.json supplements (lib/profile/profile.mjs)
  weight?: { kg: number; date: string } | null; // the latest weigh-in, for the g/kg fuelling amounts
  sports?: any[]; // the in-page onboarding's sports (lib/profile/onboarding.mjs), absent without one
}
const { nut, plan, locale, page, hidden, intakeHost = true, supplements = [], weight = null, sports } = Astro.props;
const T = personalNutriText(locale === 'es' ? esNutri : enNutri, sports, locale);
const es = locale === 'es';
const nutri = buildNutriToday(nut, plan, { supplements, weight, units: { g: 'g', ml: 'ml', ud: es ? 'ud' : 'pc' }, dec: es ? ',' : '.', lang: es ? 'es' : 'en', sports });
const F = locale === 'es' ? esFood : enFood;
const sumInfoLbl = T.infoTpl.replace('{section}', T.headings.summary);
const bake = `var NUTRI = ${jsonForScript(nutri)};\nvar I18N_NUTRI = ${jsonForScript(T)};\nvar NUTRI_ARC = ${jsonForScript(arcPath(0, 1))};\nvar I18N_FOOD = ${jsonForScript(F)};\nvar FOOD_CONST = ${jsonForScript({ meals: FOOD_MEALS, stores: FOOD_STORES, units: FOOD_UNITS, limits: FOOD_LIMITS, goals: SETTINGS_GOALS, groups: MEAL_GROUPS, mainSlots: MAIN_SLOTS, addonGroup: ADDON_GROUP, addonSlot: ADDON_SLOT, lateNightHour: LATE_NIGHT_HOUR })};\nvar FOOD_BASICS = ${jsonForScript(buildBasics(nut.ING, es ? 'es' : 'en'))};`;
---
<div class="hs-top nu-top">
  <h2 class="hs-title">{T.head.title}</h2>
  <button type="button" class="hs-i" data-hs-info="nu-intro" aria-expanded="false" aria-controls="nu-intro" aria-label={T.head.info}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg></button>
</div>
<div class="hs-info" id="nu-intro" hidden><p>{T.head.intro}</p><p>{T.head.caveat}</p></div>
<section class="tab-section" data-section="dia" id="sec-dia" hidden={hidden}>
  <div class="nutri-block" id="nutri-summary">
    <div class="hs-head">
      <h2 class="hs-lbl">{T.headings.summary}</h2>
      <button type="button" class="hs-i" data-hs-info="nutri-sum-info" aria-expanded="false" aria-controls="nutri-sum-info" aria-label={sumInfoLbl}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg></button>
    </div>
    {/* where today's intake comes from + "carbs are the rest": written by client/nutri-day.js */}
    <div class="hs-info" id="nutri-sum-info" hidden></div>
    <div class="nutri-card">
      <fieldset class="seg" id="nutri-daytype">
        <legend class="seg-lbl">{T.dayLegend}<span class="seg-src" id="nutri-daytype-src"></span></legend>
        <div class="seg-opts">
          {shownDayTypes(nutri.dayTypes, sports).map((d: string) => (
            <label class="seg-opt" title={T.dayTypes[d]}><input type="radio" name="nutri-day" value={d} /><span class="chip seg-in"><span class="seg-txt">{T.dayShort[d]}</span></span></label>
          ))}
        </div>
        <button type="button" class="lnk nutri-auto" id="nutri-auto" hidden></button>
        <p class="nutri-why" id="nutri-why"></p>
        <p class="nutri-why nutri-note" id="nutri-note" role="status" hidden></p>
      </fieldset>
      <div id="nutri-target" aria-live="polite"></div>
    </div>
    {/* intake rings: client-rendered by client/intake.js from INTAKE (baked by the shared Bake, pages/index.astro) */}
    {intakeHost && <div id="intake"></div>}
  </div>

  {/* food log (client/food-*.js): hidden until the LAN food API answers */}
  <div class="nutri-block food-block" id="food-log-block" hidden>
    {/* heading row: the title + the day navigator on the same line (the viewed day is decided at view
        time by client/food-*.js, which always opens on today) */}
    <div class="food-head">
      <h2 class="hs-lbl">{F.headings.log}</h2>
      <div class="food-day" role="group" aria-label={F.day.navLabel}>
        <button type="button" class="food-btn food-btn-ghost food-day-today" id="food-day-today" data-food-act="day-today" aria-label={F.day.back} hidden>{F.day.today}</button>
        <button type="button" class="nav-btn" id="food-day-prev" data-food-act="day-prev" aria-label={F.day.prev}><span class="chev" aria-hidden="true">‹</span></button>
        <span class="food-day-label" id="food-day-label" aria-live="polite"></span>
        <button type="button" class="nav-btn" id="food-day-next" data-food-act="day-next" aria-label={F.day.next} disabled><span class="chev" aria-hidden="true">›</span></button>
      </div>
    </div>
    <div id="food-log"></div>
    <p class="food-msg" id="food-msg" role="status" aria-live="polite"></p>
  </div>

  <details class="nutri-block sec-fold nutri-fold" id="nutri-plan-fold"><summary><h2>{T.headings.plan}</h2><span class="nutri-fold-kcal" id="nutri-plan-kcal"></span><span class="chev">›</span></summary>
    <div id="nutri-plan"></div>
  </details>

  <div class="nutri-block" id="nutri-fuel-block" hidden>
    <div class="hs-head"><h2 class="hs-lbl">{T.headings.fuel}</h2></div>
    <div class="nutri-card">
      <div id="nutri-ride-wrap"></div>
      <div id="nutri-fuel-body"></div>
    </div>
  </div>

  {/* Balance (client/health.js renderBalance, HEALTH.energy from the shared Bake): intake vs
      expenditure + the macro split over the baked window; hidden when there is no expenditure data */}
  <div class="nutri-block" id="nutri-balance" hidden></div>

  {/* the nutrition score (client/nutri-score.js, lib/nutrition/score.mjs): the day's adherence to its
      targets + the 7 / 30-day averages and a 30-day line, a tap opens its trend sheet; hidden without
      any food log day (baked INTAKE.log or the LAN summary). The formula sits behind its ⓘ */}
  <div class="nutri-block" id="nutri-score-block" hidden>
    <div class="hs-head">
      <h2 class="hs-lbl">{T.headings.score}</h2>
      <button type="button" class="hs-i" data-hs-info="nutri-score-info" aria-expanded="false" aria-controls="nutri-score-info" aria-label={T.infoTpl.replace('{section}', T.headings.score)}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg></button>
    </div>
    <div class="hs-info" id="nutri-score-info" hidden></div>
    <div id="nutri-score" aria-live="polite"></div>
  </div>

  {/* Progreso (client/progress.js): weight vs the goal from the baked DETAIL weight series; always
      rendered (an empty state without weigh-ins). After the day's blocks: today's actions come first,
      the multi-week look back follows */}
  <div class="nutri-block" id="nutri-progress-block">
    <div class="hs-head">
      <h2 class="hs-lbl">{T.headings.progress}</h2>
      <button type="button" class="hs-i" id="nutri-progress-i" data-hs-info="nutri-progress-info" aria-expanded="false" aria-controls="nutri-progress-info" aria-label={T.infoTpl.replace('{section}', T.headings.progress)}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg></button>
    </div>
    {/* the status why, the rate window and the method: written by client/progress.js */}
    <div class="hs-info" id="nutri-progress-info" hidden></div>
    <div id="nutri-progress" aria-live="polite"></div>
  </div>

  {/* Constancia (client/adherence.js): the food log's adherence, hidden until the LAN summary answers */}
  <div class="nutri-block" id="food-adherence-block" hidden>
    <div class="hs-head">
      <h2 class="hs-lbl">{T.headings.adherence}</h2>
      {/* the notes block (#adh-info) leads #food-adherence, written by client/adherence.js */}
      <button type="button" class="hs-i" data-hs-info="adh-info" aria-expanded="false" aria-controls="adh-info" aria-label={T.infoTpl.replace('{section}', T.headings.adherence)}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg></button>
    </div>
    <fieldset class="seg adh-seg" id="adh-window">
      <legend class="seg-lbl">{T.adherence.windowLegend}</legend>
      <div class="seg-opts adh-opts">
        {nutri.adherence.windows.map((w: number, i: number) => (
          <label class="seg-opt"><input type="radio" name="adh-win" value={String(w)} checked={i === 0} /><span class="chip seg-in"><span class="seg-txt">{T.adherence.windowLabel.replace('{n}', String(w))}</span></span></label>
        ))}
      </div>
    </fieldset>
    <div id="food-adherence" aria-live="polite"></div>
  </div>

  <Note
    id="dia.footnote"
    page={page}
    class="acc-note nutri-foot"
  />
</section>
<script is:inline set:html={bake}></script>
