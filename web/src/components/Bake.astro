---
/* Bakes JSON-safe globals for the client scripts (classic, is:inline — no
 * ES modules, see design's Scripts row) using lib/serialize.mjs's
 * `jsonForScript` for safe embedding inside a <script> tag. ONE shared
 * Bake, rendered once by web/pages/index.astro (outside any section, so
 * page.hideTabs never drops it): the training sections (TRAINING /
 * TRAINING_META / DASH / I18N_HOY / I18N_DASH), Salud (HEALTH /
 * I18N_HEALTH), Inicio (SCORES / DIALS / I18N_SCORE) and the intake rings
 * (INTAKE / I18N_INTAKE).
 */
import { jsonForScript } from '../../../lib/serialize.mjs';
import { buildDials } from '../view/dial.mjs';

import { es as esHoy, en as enHoy } from '../i18n/hoy-templates.mjs';
import { es as esDash, en as enDash } from '../i18n/dash-templates.mjs';
import { es as esHealth, en as enHealth } from '../i18n/health-templates.mjs';
import { es as esScore, en as enScore } from '../i18n/score-templates.mjs';
import { es as esIntake, en as enIntake } from '../i18n/intake-templates.mjs';

interface Props {
  locale: string;
  training: Record<string, any>; // training.days, verbatim
  trainingMeta: { program: string; coach: string; source: string; first: string; last: string; count: number };
  dash: any; // lib/training/dashboard.mjs's dashboardFrom() result
  health: any; // lib/health/aggregate.mjs's healthFrom() result
  scores: any; // lib/score/index.mjs's buildScoresFrom() result (Home tab; only asOf dates, no build-time now)
  intake: any; // lib/nutrition/intake.mjs's intakeFrom() result + log (lib/nutrition/read.mjs buildFoodlogBake; no build-time now)
}
const { locale, training, trainingMeta, dash, health, scores, intake } = Astro.props;
const es = locale === 'es';
const hoyTemplates = es ? esHoy : enHoy;
const dashTemplates = es ? esDash : enDash;
const healthTemplates = es ? esHealth : enHealth;
const scoreTemplates = es ? esScore : enScore;
const intakeTemplates = es ? esIntake : enIntake;

const globals = {
  LOCALE: locale,
  TRAINING: training,
  TRAINING_META: trainingMeta,
  DASH: dash,
  I18N_HOY: hoyTemplates,
  I18N_DASH: dashTemplates,
  HEALTH: health,
  I18N_HEALTH: healthTemplates,
  SCORES: scores,
  DIALS: buildDials(scores, health), // Inicio dial geometry over SCORES + the stated sleep target (view/dial.mjs)
  I18N_SCORE: scoreTemplates,
  INTAKE: intake,
  I18N_INTAKE: intakeTemplates,
};

const bakeSource = Object.entries(globals)
  .map(([name, value]) => `var ${name} = ${jsonForScript(value)};`)
  .join('\n');
---
<script is:inline set:html={bakeSource}></script>
