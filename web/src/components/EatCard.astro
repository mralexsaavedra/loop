---
/* Inicio's compact "Hoy comes / Today you eat" card: today's day type (auto or chosen) and goal, and
 * that day's target kcal / protein / carbs / fat — the same numbers Nutrición's Resumen de hoy shows,
 * written into #eat-body by client/nutri-day.js from NUTRI (baked by tabs/Dia.astro) on the viewer's
 * clock. The day type and goal are picked in Nutrición; the full meal plan is NOT repeated here.
 */
import { es as esNutri, en as enNutri } from '../i18n/nutri-templates.mjs';

interface Props {
  locale: string;
  link?: boolean; // false when page.hideTabs hides Nutrición: no link to an unreachable tab
}
const { locale, link = true } = Astro.props;
const t = (locale === 'es' ? esNutri : enNutri).eat;
---
<div class="eat-card">
  <div class="eat-head">
    <h3>{t.heading}</h3>
  </div>
  <div id="eat-body" aria-live="polite"></div>
  {link && <button type="button" class="lnk eat-link" onclick="setTab('nutricion')">{t.fullPlan} →</button>}
</div>
